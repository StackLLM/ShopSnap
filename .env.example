# Copier en .env puis adapter (le fichier .env n'est jamais versionné).

# Dossier où les médias sont enregistrés sur ta machine (par défaut : ./donnees)
SHOPSNAP_DESTINATION=./donnees

# Texte affiché dans la page pour indiquer la destination
DESTINATION_LABEL=ShopSnap/donnees

# Port de la page web : http://127.0.0.1:8765
SHOPSNAP_PORT=8765
